# Public production URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=

# Full Formspree/Web3Forms-compatible POST endpoint. The form shows a safe
# email fallback when this is blank. Example: https://formspree.io/f/your-id
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional Google Analytics measurement ID (analytics is not loaded by default)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
